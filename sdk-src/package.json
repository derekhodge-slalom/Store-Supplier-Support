{
  "name": "x-sln-store-supplier-support",
  "version": "1.0.0",
  "description": "CSM case management for store supply requests, issues, supplier fulfillment, and stockroom receipts",
  "license": "UNLICENSED",
  "scripts": {
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "deploy": "now-sdk install --auth demo5",
    "deploy:no-demo": "now-sdk install --auth demo5 --demoData=false",
    "types": "now-sdk dependencies --auth demo5",
    "validate:demo5": "node scripts/validate-demo5.cjs",
    "configure:employee-center-nav:demo5": "node scripts/configure-employee-center-navigation-demo5.cjs",
    "seed:demo-cases:demo5": "node scripts/seed-demo-cases-demo5.cjs",
    "migrate:store-models:demo5": "node scripts/migrate-store-models-demo5.cjs",
    "test:atf:demo5": "node scripts/run-atf-demo5.cjs",
    "source:apply:demo5": "node scripts/apply-source-demo5.cjs",
    "source:commit:demo5": "node scripts/commit-source-demo5.cjs"
  },
  "devDependencies": {
    "@servicenow/sdk": "4.9.2",
    "@servicenow/glide": "27.0.5"
  }
}
